# .env.example — copy to .env and fill in real values before running docker-compose
# DO NOT commit .env to git

# Backend secrets
SECRET_KEY=change-this-to-a-random-32-char-string-in-production

# Frontend / NextAuth
NEXTAUTH_SECRET=change-this-to-a-random-32-char-string-in-production

# Database
POSTGRES_PASSWORD=gympass

# Optional
ANTHROPIC_API_KEY=

# Observabilidad (opcional)
LOG_LEVEL=INFO
# Si SENTRY_DSN está vacío, Sentry no se inicializa (no requiere cuenta).
SENTRY_DSN=
